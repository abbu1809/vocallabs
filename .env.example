# ==============================================================================
# VocalLabs — Environment Configuration Template
# ==============================================================================
# Copy this file to .env: cp .env.example .env

# ------------------------------------------------------------------------------
# 1. AI & LLM PROVIDER (Required for AI agent steps)
# ------------------------------------------------------------------------------
# Get your FREE Groq API key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ------------------------------------------------------------------------------
# 2. POSTGRES DATABASE (Docker Container)
# ------------------------------------------------------------------------------
POSTGRES_USER=nhost
POSTGRES_PASSWORD=nhost
POSTGRES_DB=nhost
POSTGRES_PORT=5432
DATABASE_URL=postgres://nhost:nhost@localhost:5432/nhost

# ------------------------------------------------------------------------------
# 3. HASURA GRAPHQL ENGINE
# ------------------------------------------------------------------------------
# Admin secret used to secure Hasura GraphQL API, metadata, & console
HASURA_GRAPHQL_ADMIN_SECRET=nhost-admin-secret
HASURA_ADMIN_SECRET=nhost-admin-secret

# Console & API URLs (Local Development)
HASURA_PORT=8080
HASURA_URL=http://localhost:8080
HASURA_GRAPHQL_URL=http://localhost:8080/v1/graphql
HASURA_GRAPHQL_CONSOLE_URL=http://localhost:8080/console

# ------------------------------------------------------------------------------
# 4. JWT & AUTHENTICATION
# ------------------------------------------------------------------------------
# Minimum 64-character secret for signing HS256 tokens (Auth & Hasura Claims)
JWT_SECRET=0123456789012345678901234567890123456789012345678901234567891234

# ------------------------------------------------------------------------------
# 5. SERVERLESS FUNCTIONS (Execution Engine & Custom Actions)
# ------------------------------------------------------------------------------
FUNCTIONS_PORT=3001
FUNCTIONS_URL=http://localhost:3001

# ------------------------------------------------------------------------------
# 6. FRONTEND CLIENT (Next.js Public Variables)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_HASURA_HTTP_URL=http://localhost:8080/v1/graphql
NEXT_PUBLIC_HASURA_WS_URL=ws://localhost:8080/v1/graphql
NEXT_PUBLIC_FUNCTIONS_URL=http://localhost:3001
